// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User Model ───────────────────────────────────────────────────────────────
model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String
  role           String    @default("employee") // "admin" | "teamlead" | "employee"
  specialization String?
  team           String?
  status         String    @default("Active")   // "Active" | "Inactive"
  phone          String?
  accentColor    String?   @default("#6366f1")
  avatar         String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  assignedTasks  Task[]    @relation("AssigneeTasks")
  sentRequests   Request[] @relation("SenderRequests")
  checkIns       CheckIn[]

  @@map("users")
}

// ─── Task Model ───────────────────────────────────────────────────────────────
model Task {
  id          Int      @id @default(autoincrement())
  title       String
  assigneeId  Int
  supporters  String?  // JSON string: array of supporter names/ids
  deadline    String   // ISO date string
  status      String   @default("Cần làm") // "Cần làm" | "Đang làm" | "Chờ test" | "Chờ review" | "Hoàn thành" | "Trễ hạn"
  statusType  String?  // e.g. "default" | "warning" | "success" | "danger"
  dueType     String?  // e.g. "normal" | "urgent" | "overdue"
  description String?

  // Master Project & Stage fields
  isMasterProject Boolean  @default(false)
  masterTaskId    Int?
  masterTaskTitle String?
  creatorId       Int?
  creatorName     String?
  progress        Int?     @default(0)
  pipelineStage   String?
  handoverHistory String?  // JSON string: array of HandoverRecords
  budget          String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignee    User     @relation("AssigneeTasks", fields: [assigneeId], references: [id])

  @@map("tasks")
}

// ─── Request Model ────────────────────────────────────────────────────────────
model Request {
  id             Int      @id @default(autoincrement())
  senderId       Int
  senderName     String
  role           String
  type           String   // "Nghỉ phép" | "OT" | "Chấm công bù"
  description    String?
  reason         String?
  date           String   // ISO date string
  status         String   @default("pending") // "pending" | "approved" | "rejected"
  hasAttachment  Boolean  @default(false)
  attachmentName String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  sender         User     @relation("SenderRequests", fields: [senderId], references: [id])

  @@map("requests")
}

// ─── CheckIn Model ────────────────────────────────────────────────────────────
model CheckIn {
  id       Int      @id @default(autoincrement())
  userId   Int
  userName String
  type     String   // "in" | "out"
  time      String   // HH:mm format
  date      String   // YYYY-MM-DD format
  shiftName String?  @default("Ca Sáng") // "Ca Sáng" | "Ca Chiều" | "Ca Tối"

  createdAt DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id])

  @@map("checkins")
}
